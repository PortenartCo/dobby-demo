+    }
+    if(directory&&(size!==0||checksum!==0))reject('INVALID_ZIP','Un dossier ZIP contient des données inattendues.');
+    const ext=name.split('.').at(-1).toLowerCase();
+    if(!directory&&!['json','png','jpg','jpeg','webp'].includes(ext))reject('UNSUPPORTED_FILE','Le ZIP ne peut contenir qu’un JSON et des images JPEG, PNG ou WebP.');
+    if(!directory&&size>(ext==='json'?limit.jsonBytes:limit.imageBytes))reject('LIMIT',ext==='json'?'JSON trop volumineux : 2 Mo maximum.':'Image trop volumineuse : 10 Mo maximum.');
