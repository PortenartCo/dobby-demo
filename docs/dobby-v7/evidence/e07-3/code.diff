+ async function action(name,el,ctx){if(!name.startsWith('e073-import-'))return false;const kind=name.slice(12);
+  if(kind==='cancel'){generation++;busy=false;prepared=null;choices={};replaceTM5={};message='Import annulé : aucune recette enregistrée.';clearPreview();await ctx.render();return true;}
